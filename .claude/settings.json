{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; npx biome check --write --no-errors-on-unmatched --files-ignore-unknown=true \"$f\"; } >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 120,
            "statusMessage": "Typecheck + lint"
          }
        ]
      }
    ]
  }
}
