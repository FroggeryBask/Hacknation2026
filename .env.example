# Copy to .env.local and fill in. Never commit .env.local.

# Public: safe in the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET: server only. Dashboard > Connect > ORMs (Drizzle) > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# SECRET: server only. Eden AI (organizer-provided LLM/OCR), see materialy/Dostęp do AI (Eden AI) - mail od organizatorów.md
EDENAI_API_KEY=
