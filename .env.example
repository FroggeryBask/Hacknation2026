# Copy to .env (docker compose, api/) or .env.local (npm run dev). Never commit real values.

# --- API (prefix AUTOFORMULARZ_) ---
# SECRET: shared HS256 key for JWT. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOFORMULARZ_JWT_SECRET=
# Set to false only for local development without tokens
AUTOFORMULARZ_AUTH_ENABLED=true
# AUTOFORMULARZ_JWT_AUDIENCE=
AUTOFORMULARZ_MAX_UPLOAD_MB=20
# LLM provider: eden (default, also in Docker; team decision 2026-11-21) or ollama (local model, offline:
# docker compose --profile ollama)
AUTOFORMULARZ_LLM_PROVIDER=eden
AUTOFORMULARZ_OLLAMA_URL=http://localhost:11434
AUTOFORMULARZ_LLM_MODEL=qwen3-vl:8b
# Ollama on CPU needs long limits for large forms (README, "Wymagania sprzętowe i czasy")
AUTOFORMULARZ_LLM_TIMEOUT_S=1800
# Context window (prompt + answer) in Ollama: 24576 fits form 8; more context = more RAM
AUTOFORMULARZ_LLM_NUM_CTX=24576
# Max length of the model answer: cuts a repetition loop early (time and Eden cost)
AUTOFORMULARZ_LLM_MAX_TOKENS=12000
# Best of N: the model answers N times, the code keeps the best answer (more complete, fewer made-up
# fields); N calls per form. 1 for the live API, 3 for the delivered results
AUTOFORMULARZ_LLM_SAMPLES=1
# How long Ollama keeps the model in memory after a request: the next form skips loading it (seconds on GPU,
# up to a minute on CPU) and reuses the cached system prompt
AUTOFORMULARZ_LLM_KEEP_ALIVE=30m
AUTOFORMULARZ_MAX_PDF_PAGES=6
# Copy instructions verbatim from the source, checked in code (the legal basis is always copied)
# AUTOFORMULARZ_COPY_SOURCE_TEXT=true
AUTOFORMULARZ_CORS_ORIGINS=http://localhost:3000
# Path to LibreOffice for .doc/.ods (found automatically on PATH and in Program Files on Windows)
# AUTOFORMULARZ_SOFFICE_BIN=soffice
# OCR for scans (Tesseract + Polish model). Found automatically on PATH and in Program Files on Windows.
# Without it scans go to the model only as images.
# AUTOFORMULARZ_OCR_BIN=tesseract
# AUTOFORMULARZ_OCR_LANG=pol
# Folder with pol.traineddata if it is not in Tesseract's default tessdata (e.g. Windows installer)
# AUTOFORMULARZ_TESSDATA_DIR=

# --- Eden AI (organizer-provided, OpenAI-compatible) ---
# SECRET: server only. Only open-weight models (they must also run locally, see CLAUDE.md > AI access).
# Mail with endpoints: materialy/Dostęp do AI (Eden AI) - mail od organizatorów.md
# Default provider (also in Docker): fill in the key. The model defaults to the team's one below.
# Every call costs: docs/eden-budzet.md
# Eden: deepinfra/deepseek-ai/DeepSeek-V4.1-Flash (open weights, text + images); before: deepinfra/Qwen/Qwen3-VL-30B-A3B-Instruct (Ollama: qwen3-vl:30b)
EDENAI_API_KEY=
# AUTOFORMULARZ_EDEN_MODEL=deepinfra/deepseek-ai/DeepSeek-V4.1-Flash
# Thinking off on Eden (reasoning_effort + the Qwen3 /no_think switch); empty = send neither
# AUTOFORMULARZ_EDEN_REASONING_EFFORT=none
# AUTOFORMULARZ_EDEN_BASE_URL=https://api.edenai.run/v3

# --- Frontend (server-side only) ---
AUTOFORMULARZ_API_URL=http://localhost:8000
